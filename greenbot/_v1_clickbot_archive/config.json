    "spot_10": { "pick": "largest" },
    "spot_11": { "pick": "largest" },
    "spot_12": { "pick": "largest" },
    "spot_13": { "pick": "largest" },
    "spot_14": { "pick": "largest" },
    "spot_15": { "pick": "largest" },
    "spot_16": { "pick": "largest" },
    "spot_17": { "pick": "largest" },
    "spot_18": { "pick": "largest" },
    "spot_19": { "pick": "largest" },
    "spot_20": { "pick": "largest" }
  }
