{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "servo-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "arduino/servo_control/servo-web.js"
      ],
      "port": 8090,
      "autoPort": true
    },
    {
      "name": "mouse-sim",
      "runtimeExecutable": "mouse-sim/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "mouse-sim/serve.py",
