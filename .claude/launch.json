        "8765"
      ],
      "port": 8765
    },
    {
      "name": "mouse-sim compare",
      "runtimeExecutable": "mouse-sim/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "mouse-sim/compare.py",
        "--port",
        "8771"
      ],
      "port": 8771
    }
  ]
}
