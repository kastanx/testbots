[Unit]
Description=USB mouse that looks like a SteelSeries Rival 600 (FunctionFS)
Requires=sys-kernel-config.mount
After=sys-kernel-config.mount
Conflicts=hid-gadget.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/rival600.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
